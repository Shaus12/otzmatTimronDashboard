NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: server-only. Used to store/refresh OAuth tokens without exposing them to the browser.
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public app origin used for OAuth redirect_uri (e.g. http://localhost:3000)
NEXT_PUBLIC_APP_URL=
# Shared secret for /api/cron/gmail-sync (Authorization: Bearer <CRON_SECRET>).
# Required for unattended Gmail auto-sync. On Vercel, Cron sends this automatically when set.
CRON_SECRET=
